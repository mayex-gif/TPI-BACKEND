      "credentials": [
        {
          "type": "password",
          "value": "password123",
          "temporary": false
        }
      ],
      "realmRoles": ["CLIENTE"]
    },
    {
      "username": "ADMIN",
      "enabled": true,
      "emailVerified": true,
