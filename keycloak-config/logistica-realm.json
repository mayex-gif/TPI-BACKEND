{
  "id": "logistica-realm",
  "realm": "logistica-realm",
  "displayName": "Sistema de Logística Mínimo",
  "enabled": true,
  "sslRequired": "none",
  "roles": {
    "realm": [
      {
        "name": "CLIENTE",
        "description": "Usuario cliente que solicita transportes",
        "composite": false
      },
      {
        "name": "OPERADOR",
        "description": "Operador que gestiona solicitudes y asignaciones",
        "composite": false
      },
      {
        "name": "TRANSPORTISTA",
        "description": "Transportista que ejecuta los traslados",
        "composite": false
      },
      {
        "name": "ADMINISTRADOR",
        "description": "Administrador del sistema",
        "composite": false
      }
    ]
  },
  "clients": [
    {
      "clientId": "logistica-client",
      "name": "Cliente de Acceso Directo",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "logistica-secret-123",
      "redirectUris": [
        "*"
      ],
      "webOrigins": [
        "*"
      ],
      "protocol": "openid-connect",
      "publicClient": false,
      "directAccessGrantsEnabled": true,
      "bearerOnly": false,
      "standardFlowEnabled": true
    }
  ],
  "users": [
    {
      "username": "cliente1",
