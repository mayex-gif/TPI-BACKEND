{
  "id": "logistica-realm",
  "realm": "logistica-realm",
  "displayName": "Sistema de Logística",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "roles": {
    "realm": [
      {
        "name": "CLIENTE",
        "description": "Usuario cliente que solicita transportes",
        "composite": false
      },
      {
        "name": "OPERADOR",
        "description": "Operador que gestiona solicitudes y asignaciones",
        "composite": false
      },
      {
        "name": "TRANSPORTISTA",
        "description": "Transportista que ejecuta los traslados",
        "composite": false
      },
      {
        "name": "ADMINISTRADOR",
        "description": "Administrador del sistema",
        "composite": false
      }
    ]
  },
  "clients": [
    {
      "clientId": "logistica-client",
      "name": "Logistica Client",
      "description": "Cliente para API Gateway y Microservicios",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "logistica-secret-123",
      "redirectUris": [
        "*"
      ],
      "webOrigins": [
        "*"
      ],
      "protocol": "openid-connect",
      "publicClient": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "bearerOnly": false,
      "authorizationServicesEnabled": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "attributes": {
        "access.token.lifespan": "300",
        "client.secret.creation.time": "1700000000"
      }
    }
  ],
  "users": [
    {
